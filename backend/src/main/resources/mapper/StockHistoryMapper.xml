<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wms.backend.mapper.StockHistoryMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stock_history(
            product_id,
            movement_type,
            movement_quantity
        ) VALUES(
            #{productId},
            #{movementType},
            #{movementQuantity}
        )
    </insert>

    <select id="select" resultType="com.wms.backend.entity.StockHistory">
        SELECT *
        FROM stock_history

        <where>
            <if test="filter != null and filter!=''">
                movement_type= #{filter}
            </if>
        </where>


        <choose>
            <when test="sortColumn != null and sortDir != null">
                ORDER BY ${sortColumn} ${sortDir}
            </when>
            <otherwise>
                ORDER BY id ASC
            </otherwise>
        </choose>

        <!--   ex) LIMIT 10 OFFSET 5 = > 5개 건너 뛰고  10(6~15)개 가져오기    -->
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 이력 개수 조회 (페이징용) -->
    <select id="countHistory" resultType="int">
        SELECT COUNT(*)
        FROM stock_history
        <where>
            <if test="filter != null and filter != ''">
                movement_type= #{filter}
            </if>
        </where>
    </select>


    <!--  오늘 반입 개수 조회  -->
    <select id="todayInCount" resultType="int">
        SELECT COUNT(*)
        FROM stock_history
        WHERE movement_type = 'IN' AND DATE(created_at) = CURRENT_DATE;
    </select>

    <!--  오늘 반출 개수 조회  -->
    <select id="todayOutCount" resultType="int">
        SELECT COUNT(*)
        FROM stock_history
        WHERE movement_type = 'OUT' AND DATE(created_at) = CURRENT_DATE;
    </select>


</mapper>